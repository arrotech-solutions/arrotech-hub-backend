security_group_id        = "sg-REPLACE_WITH_SECURITY_GROUP_ID"
elastic_ip_allocation_id = "eipalloc-REPLACE_WITH_ALLOCATION_ID"
backend_ami_id           = "ami-REPLACE_WITH_ENCRYPTED_BACKEND_AMI_ID"
rollback_ami_id          = "ami-REPLACE_WITH_ROLLBACK_AMI_ID"
