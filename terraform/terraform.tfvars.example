aws_region  = "us-east-1"
aws_profile = "REPLACE_WITH_LOCAL_AWS_PROFILE"

instance_id              = "i-REPLACE_WITH_ACTIVE_INSTANCE_ID"
rollback_instance_id     = "i-REPLACE_WITH_ROLLBACK_INSTANCE_ID"
vpc_id                   = "vpc-REPLACE_WITH_VPC_ID"
